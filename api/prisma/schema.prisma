// POS Platform — data-plane schema.
// Global identity: user, operator, refresh_token (no RLS).
// Tenant-owned: business, membership (RLS enforced via enable_tenant_rls()).
// See docs/design/data/data-model.md and docs/design/architecture/multi-tenancy.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Global user identity. Tenant access is granted separately (membership / winger account).
model User {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  email        String?      @unique
  phone        String?      @unique
  passwordHash String       @map("password_hash")
  locale       String       @default("en")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt   DateTime?    @map("disabled_at") @db.Timestamptz(6)
  memberships  Membership[]

  @@map("user")
}

/// Platform operator identity (control-plane). No data-plane access without a support grant.
model Operator {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)

  @@map("operator")
}

/// Rotating opaque refresh token. One row per issued token; rotation and reuse
/// detection operate on `familyId`. Access tokens are JWTs and are not stored.
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  subjectType  String    @map("subject_type") // 'user' | 'operator'
  subjectId    String    @map("subject_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")

  @@index([subjectType, subjectId])
  @@index([familyId])
  @@map("refresh_token")
}

/// Tenant root. RLS: `id = current_setting('app.business_id')`.
model Business {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  country            String       @default("TZ")
  currency           String       @default("TZS")
  locale             String       @default("en")
  timezone           String       @default("Africa/Dar_es_Salaam")
  subscriptionStatus String       @default("trialing") @map("subscription_status")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships        Membership[]

  @@map("business")
}

/// Binds a user to a business with a role. RLS: `business_id = current_setting('app.business_id')`.
model Membership {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String // 'owner' | 'staff'
  status     String   @default("active") // 'active' | 'suspended'
  invitedBy  String?  @map("invited_by") @db.Uuid
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("membership")
}
