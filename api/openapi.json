  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service and database are reachable."
          },
          "503": {
            "description": "Database is unreachable."
          }
        },
        "tags": [
          "health"
        ]
      }
    },
