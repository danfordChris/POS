{
  "name": "pos-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant stock management platform — API, web admin, mobile app.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.4.2"
  }
}
