# Copy to .env and adjust. Never commit .env.
# Values below match infra/docker-compose.yml defaults for local development.

# --- Runtime ---
NODE_ENV=development
GATEWAY_PORT=8000
IDENTITY_PORT=3001
TENANCY_PORT=3002

# --- Auth ---
# Generate a real secret for anything shared: `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- PostgreSQL ---
# `pos` is the compose bootstrap superuser. Each service connects as its own
# non-superuser role (identity_app, tenancy_app, …) created by infra/postgres/initdb,
# so RLS FORCE is enforced.
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# `prisma migrate dev` auto-creates and drops its own shadow database (roles have
# CREATEDB in dev). Set SHADOW_DATABASE_URL only if you point a URL at a managed
# database without CREATE DATABASE rights.

# --- Per-service databases (one shared instance, one schema + role each) ---
IDENTITY_DATABASE_URL=postgresql://identity_app:identity_app@localhost:5432/pos_dev?schema=identity
TENANCY_DATABASE_URL=postgresql://tenancy_app:tenancy_app@localhost:5432/pos_dev?schema=tenancy
CATALOG_DATABASE_URL=postgresql://catalog_app:catalog_app@localhost:5432/pos_dev?schema=catalog
INVENTORY_DATABASE_URL=postgresql://inventory_app:inventory_app@localhost:5432/pos_dev?schema=inventory
SALES_DATABASE_URL=postgresql://sales_app:sales_app@localhost:5432/pos_dev?schema=sales
WINGER_DATABASE_URL=postgresql://winger_app:winger_app@localhost:5432/pos_dev?schema=winger
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_app:notifications_app@localhost:5432/pos_dev?schema=notifications

# --- Messaging (NATS + JetStream) ---
NATS_URL=nats://localhost:4222
NATS_MONITOR_URL=http://localhost:8222

# --- Internal service auth ---
# HMAC key the gateway uses to sign the internal context forwarded to services.
# Generate: `openssl rand -base64 48`
INTERNAL_CONTEXT_SECRET=dev-only-internal-context-secret-change-me
INTERNAL_CONTEXT_TTL_SECONDS=60

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pos-local
S3_SECRET_KEY=pos-local-secret
S3_BUCKET=pos-media
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit SMTP capture in local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="POS Platform <no-reply@pos.local>"

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
