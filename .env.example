# Copy to .env and adjust. Never commit .env.
# Values below match infra/docker-compose.yml defaults for local development.

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos_dev?schema=public
# Used only by `prisma migrate dev` to diff migrations. Must be a separate database.
SHADOW_DATABASE_URL=postgresql://pos:pos@localhost:5432/pos_shadow?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pos-local
S3_SECRET_KEY=pos-local-secret
S3_BUCKET=pos-media
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit SMTP capture in local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="POS Platform <no-reply@pos.local>"

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
