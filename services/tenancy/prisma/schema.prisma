// tenancy service — owns business, membership (RLS) in the `tenancy` schema.
// Plus the transactional outbox + idempotency tables from @pos/nest-common.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANCY_DATABASE_URL")
}

/// Tenant root. RLS: `id = current_setting('app.business_id')`.
model Business {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  country            String       @default("TZ")
  currency           String       @default("TZS")
  locale             String       @default("en")
  timezone           String       @default("Africa/Dar_es_Salaam")
  subscriptionStatus String       @default("trialing") @map("subscription_status")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships        Membership[]

  @@map("business")
}

/// Binds a user (owned by `identity`) to a business. RLS: `business_id = current_setting('app.business_id')`.
model Membership {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String // 'owner' | 'staff'
  status     String   @default("active") // 'active' | 'suspended'
  invitedBy  String?  @map("invited_by") @db.Uuid
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("membership")
}

/// A pending offer of Staff membership. Only the SHA-256 `token_hash` is stored;
/// the opaque token lives only in the `InvitationCreated` event / email.
/// RLS read is relaxed (accept looks it up by token_hash with no business
/// context); WITH CHECK stays strict.
model Invitation {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  role       String    @default("staff")
  email      String
  tokenHash  String    @unique @map("token_hash")
  status     String    @default("pending") // pending | accepted | revoked | expired
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedBy String?   @map("accepted_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  @@index([businessId, status])
  @@map("invitation")
}

/// Break-glass: a time-boxed operator access grant, requested by an operator and
/// approved by an Owner. `expires_at` is capped server-side at `granted_at + 24h`.
/// RLS: strict on `business_id` (an Owner sees only their business's grants).
model SupportAccessGrant {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  operatorId String    @map("operator_id") @db.Uuid
  reason     String
  status     String    @default("pending") // pending | approved | revoked
  approvedBy String?   @map("approved_by") @db.Uuid
  grantedAt  DateTime? @map("granted_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId, status])
  @@index([operatorId])
  @@map("support_access_grant")
}

/// Append-only audit trail. Every operator read of tenant data under a grant
/// writes a row here, visible to the Owner. `business_id` may be null for
/// control-plane actions. RLS read is relaxed (a null-scoped reader sees rows);
/// WITH CHECK stays strict when `business_id` is set.
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String?  @map("business_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorType  String   @map("actor_type") // user | operator | system
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId, createdAt])
  @@map("audit_log")
}

model OutboxMessage {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subject   String
  payload   Json
  headers   Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")

  @@index([createdAt], map: "outbox_unsent_idx")
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  subject     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
}
