// sales service — owns sale, sale_line, receipt, sale_number_counter, and the
// product_cache projection in the `sales` schema. Plus the transactional outbox
// + idempotency tables. Stock movements are NOT written here — inventory writes
// them on commitReservation / on the SaleVoided consumer.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("SALES_DATABASE_URL")
}

/// A completed or voided sale. Money fields are integer minor units.
/// RLS: `business_id = current_setting('app.business_id')`.
model Sale {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  number         Int
  status         String    @default("completed") // completed | voided
  subtotal       Int
  discountTotal  Int       @default(0) @map("discount_total")
  total          Int
  currency       String
  soldBy         String    @map("sold_by") @db.Uuid
  customerLabel  String?   @map("customer_label")
  idempotencyKey String?   @map("idempotency_key")
  reservationId  String?   @map("reservation_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(6)

  lines   SaleLine[]
  receipt Receipt?

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, soldBy, createdAt])
  @@map("sale")
}

/// Immutable snapshot of one cart line. `name_snapshot` / `unit_price_snapshot`
/// are fixed at sale time so the receipt never depends on the live catalog.
model SaleLine {
  id                String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  saleId            String @map("sale_id") @db.Uuid
  businessId        String @map("business_id") @db.Uuid
  productId         String @map("product_id") @db.Uuid
  nameSnapshot      String @map("name_snapshot")
  unitPriceSnapshot Int    @map("unit_price_snapshot")
  quantity          Int
  discount          Int    @default(0)
  lineTotal         Int    @map("line_total")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([businessId, saleId])
  @@map("sale_line")
}

/// Public, tokenised receipt. `/v1/r/{public_token}` is unauthenticated, so the
/// business name is snapshotted here rather than joined.
model Receipt {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  saleId               String   @unique @map("sale_id") @db.Uuid
  publicToken          String   @unique @map("public_token")
  businessNameSnapshot String   @map("business_name_snapshot")
  currency             String
  status               String   @default("issued") // issued | void
  issuedAt             DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("receipt")
}

/// Per-business monotonic sale number. Row-locked (`FOR UPDATE`) inside the sale
/// transaction. RLS: `business_id = current_setting('app.business_id')`.
model SaleNumberCounter {
  businessId String @id @map("business_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  @@map("sale_number_counter")
}

/// Read-only projection from `tenancy.BusinessCreated`. Supplies the business
/// name + currency snapshot for a receipt (which is served without auth).
model SalesBusiness {
  businessId String @id @map("business_id") @db.Uuid
  name       String
  currency   String @default("TZS")

  @@map("sales_business")
}

/// Read-only projection from catalog `ProductUpserted` / `PriceChanged`. Fills
/// line snapshots when the client omits `unit_price`.
model ProductCache {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  name       String
  sellPrice  Int    @default(0) @map("sell_price")
  currency   String @default("TZS")

  @@unique([businessId, productId])
  @@map("product_cache")
}

model OutboxMessage {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subject   String
  payload   Json
  headers   Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")

  @@index([createdAt], map: "outbox_unsent_idx")
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  subject     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
}
