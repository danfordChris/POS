// notifications service — owns `notification` (delivery record) and
// `notification_contact` (read-only projection of tenancy membership) in the
// `notifications` schema. Plus the transactional outbox + idempotency tables.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATIONS_DATABASE_URL")
}

/// One delivery record per (trigger, channel). `dedupe_key` collapses repeats of
/// the same logical notification. RLS: `business_id = current_setting('app.business_id')`.
model Notification {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  type       String // low_stock | invitation | winger_authorized
  channel    String    @default("email")
  payload    Json
  status     String    @default("queued") // queued | sent | failed
  dedupeKey  String?   @map("dedupe_key")
  attempts   Int       @default(0)
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)

  @@unique([businessId, dedupeKey])
  @@index([businessId, status])
  @@map("notification")
}

/// Read-only projection from `tenancy` events. Never written from anything but
/// `BusinessCreated` / `MembershipCreated` / `MembershipSuspended`.
/// RLS: `business_id = current_setting('app.business_id')`.
model NotificationContact {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String // owner | staff
  email      String?
  locale     String   @default("en")
  active     Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([businessId, userId])
  @@index([businessId, role, active])
  @@map("notification_contact")
}

/// Business name + default locale, projected from `tenancy.BusinessCreated`.
/// Used to render alert emails. Internal — no RLS, no HTTP surface.
model NotificationBusiness {
  businessId String   @id @map("business_id") @db.Uuid
  name       String
  locale     String   @default("en")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_business")
}

/// Per-business digest cadence, projected from inventory's `AlertConfigChanged`.
/// Internal worker config — no RLS, no HTTP surface.
model DigestConfig {
  businessId       String   @id @map("business_id") @db.Uuid
  minIntervalHours Int      @default(24) @map("min_interval_hours")
  recipients       Json     @default("[]")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("digest_config")
}

model OutboxMessage {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subject   String
  payload   Json
  headers   Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")

  @@index([createdAt], map: "outbox_unsent_idx")
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  subject     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
}
